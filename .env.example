# Chaos environment variables. Copy to `.env` (docker compose) or `.env.local`
# (local dev) and fill in. Never commit real values; `.env*` is gitignored.
#
# Legend: [required] must be set; [optional] has a default or disables a feature.
# "build" = public value inlined into the browser bundle at `next build` /
# `docker build` time (changing it needs a rebuild). "runtime" = read when the
# server runs. "convex" = set on the Convex deployment (`npx convex env set`),
# not in the Next.js process; the docker deploy step does this for you.

# --- Convex backend (self-hosted) -------------------------------------------
# [required, build] Public URL browsers use for the Convex API/websocket.
# Hosted development: leave blank; `convex dev` writes your .cloud URL.
# Docker local trial: set http://127.0.0.1:3210.
NEXT_PUBLIC_CONVEX_URL=
# [required for self-host, build] Public URL of Convex HTTP actions (public API,
# webhooks, MCP). Hosted Convex derives this from the .cloud URL; self-hosted cannot.
# Hosted development: leave blank to derive the .site URL from .cloud.
# Docker local trial: set http://127.0.0.1:3211.
NEXT_PUBLIC_CONVEX_SITE_URL=
# [required, compose] Random secret for the Convex backend, e.g. `openssl rand -hex 32`.
CONVEX_INSTANCE_SECRET=
# [optional, compose] Convex instance name.
CONVEX_INSTANCE_NAME=chaos-self-hosted
# [required for deploy] Admin key: `docker compose exec backend ./generate_admin_key.sh`.
# Treat as a root credential. The Convex CLI reads it as CONVEX_SELF_HOSTED_ADMIN_KEY.
CONVEX_SELF_HOSTED_ADMIN_KEY=
# [optional, compose] Set to true ONLY for plain-http local trials; remove behind TLS.
CONVEX_DO_NOT_REQUIRE_SSL=true
# [optional, compose] External Postgres/MySQL URL instead of bundled SQLite.
CONVEX_DATABASE_URL=
# [optional, compose] Pin image tags for reproducible upgrades.
CONVEX_BACKEND_TAG=latest
CONVEX_DASHBOARD_TAG=latest

# --- Clerk (authentication; required today, hosted service, not self-hostable) -
# [required, build] Clerk publishable key (pk_...).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# [required, runtime] Clerk secret key (sk_...). Used by proxy.ts (clerkMiddleware).
CLERK_SECRET_KEY=
# [required, convex] Clerk Frontend API URL, the issuer of the "convex" JWT template,
# e.g. https://your-app.clerk.accounts.dev. Deployment refuses an unset issuer.
CLERK_JWT_ISSUER_DOMAIN=

# --- App URLs ----------------------------------------------------------------
# [recommended, build] Public origin of the app, used for SEO/sitemap/canonical
# links. Defaults to https://chaos.fail if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# [recommended, convex] Public app origin used in links built by Convex
# (share/MCP/webhooks). Defaults to NEXT_PUBLIC_APP_URL in the docker deploy step.
CHAOS_APP_URL=http://localhost:3000

# --- Support contact (optional) ----------------------------------------------
# [optional, build] Address shown in the footer, legal pages and help rows.
NEXT_PUBLIC_SUPPORT_EMAIL=
# [optional, convex] Address shown in error messages from the backend. Use the same value.
CHAOS_SUPPORT_EMAIL=

# --- ChatGPT app / MCP (optional) --------------------------------------------
# [optional, runtime + convex] Shared secret (32+ random chars), identical in the
# Next.js app and on Convex. Leave empty to disable the /mcp ChatGPT integration.
CHAOS_MCP_SECRET=
# [optional, runtime] Comma-separated OAuth client ids allowed to use /mcp (the ChatGPT app's id from the Clerk dashboard).
# Empty = any OAuth client of this Clerk instance.
CHAOS_MCP_CLIENT_IDS=
# [optional, runtime] OpenAI Apps domain-verification token.
OPENAI_APPS_CHALLENGE_TOKEN=

# --- Analytics (optional) ----------------------------------------------------
# [optional, build] PostHog project token and host. Leave empty for no analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Webhooks and integration API (optional, convex) -------------------------
# Encrypts webhook signing secrets. Set 32+ random characters to enable webhooks.
# Keep this key stable across upgrades; existing encrypted secrets depend on it.
CHAOS_WEBHOOK_KEY=
# Local development only: "1" permits localhost webhook targets. Leave blank otherwise.
CHAOS_WEBHOOK_ALLOW_LOCALHOST=
# Per-connection requests per minute; dashboard configuration takes precedence.
CHAOS_API_READ_RATE_PER_MINUTE=300
CHAOS_API_WRITE_RATE_PER_MINUTE=60

# --- Compose ports (optional) ------------------------------------------------
APP_PORT=3000
CONVEX_API_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791
# Bind the admin dashboard to localhost unless you know why not.
CONVEX_DASHBOARD_BIND=127.0.0.1

# --- Not read by the app, but you may see them elsewhere ----------------------
# CONVEX_SITE_URL (runtime, optional): overrides where app/mcp/route.ts finds the
# Convex HTTP actions URL. Compose sets it to http://backend:3211 for you.

# --- Public site links (optional) ---------------------------------------------
# [optional, build] Hosted status page (any provider), e.g. https://status.example.com.
# Must be https. When set, the footer, /support and error pages link to it; unset
# or invalid hides those links.
NEXT_PUBLIC_STATUS_PAGE_URL=
# [optional, build] Short share origin, e.g. https://chs.example. https origin
# only: no path, query or fragment (invalid values are ignored). lib/site.ts
# shortShareUrl("/f/abc") then returns https://chs.example/f/abc. Point the
# domain at this app: proxy.ts 301-redirects every request on that host to the
# same path and query on NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SHORT_SHARE_ORIGIN=

# --- Member card Google Wallet pass (optional, runtime, server-only) -------------
# Leave empty to hide "Add to Google Wallet". The key is PEM text
# or base64-encoded PEM. See docs/self-hosting.md, "Wallet passes".
# Google: needs a Google Wallet issuer account and a service account with its key.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
