{
  "name": "chaos",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "build": "next build --webpack",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "pnpm lint:oxlint && pnpm lint:framework",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "test": "npm-run-all --sequential test:unit test:integration",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:layout": "playwright test -c playwright.layout.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:correctness": "tsx scripts/correctness.ts",
    "perf": "vitest run --config vitest.perf.config.mts",
    "perf:bundles": "tsx scripts/perf-bundles.ts",
    "perf:css": "tsx scripts/perf-css.ts",
    "css:build-audit": "tsx scripts/css-build-audit.ts",
    "perf:check": "tsx scripts/perf-ratchet.ts check",
    "perf:ratchet": "tsx scripts/perf-ratchet.ts update",
    "perf:guard": "tsx scripts/perf-guard.ts",
    "perf:pr-summary": "tsx scripts/perf-pr-summary.ts",
    "mcp:inventory": "tsx scripts/mcp-inventory.ts",
    "mcp:inventory:check": "tsx scripts/mcp-inventory.ts --check",
    "mcp:synthetic": "tsx scripts/mcp-synthetic.ts",
    "health:production": "tsx scripts/production-health.ts",
    "flags:check": "tsx scripts/flags-check.ts",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:framework": "eslint . --max-warnings 0",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip:check": "node scripts/knip-check.mjs"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "~1.6.33",
    "@blobatar/react": "^2.7.0",
    "@blocknote/code-block": "0.55.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/shadcn": "0.55.0",
    "@clerk/localizations": "^4.21.2",
    "@clerk/mcp-tools": "^0.6.0",
    "@clerk/nextjs": "^7.9.10",
    "@convex-dev/better-auth": "0.12.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "~1.6.33",
    "blobatar": "^2.7.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mermaid": "12.1.0",
    "next": "^16.4.0",
    "posthog-js": "^1.436.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.60",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "jsqr": "^1.4.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0",
    "oxlint": "^1.87.0",
    "knip": "^6.40.0",
    "@babel/parser": "^8.0.6",
    "@next/eslint-plugin-next": "^16.4.0",
    "@babel/eslint-parser": "^8.0.6"
  }
}
