  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "test": "npm-run-all --sequential test:unit test:integration",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "mcp:inventory": "tsx scripts/mcp-inventory.ts",
    "mcp:inventory:check": "tsx scripts/mcp-inventory.ts --check"
  },
